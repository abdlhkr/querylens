# Bu dosyayi ".env" olarak kopyalayip degerleri doldur. .env ASLA commit edilmez.

# Tum Postgres instance'lari icin parola
DB_PASSWORD=

# auth-service ve gateway-service'te AYNI olmali. Uret: openssl rand -base64 64
JWT_SECRET=

# Google Cloud Console > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# platform.openai.com > API keys
OPENAI_API_KEY=

# Gmail SMTP (2FA acik hesapta App Password olustur: myaccount.google.com/apppasswords)
MAIL_USERNAME=
MAIL_PASSWORD=
